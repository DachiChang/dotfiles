// NOTE: bunx oh-my-opencode-slim@latest install --no-tui --skills=yes --companion=no
{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "autoUpdate": true,
  "disabled_mcps": [ // don't need these mcps carried by oh-my-opencode-slim, had been enabled in opencode.json
    "websearch",
    "context7",
    "gh_grep"
  ],
  "preset": "a-team",
  "presets": {
    "a-team": {
      "orchestrator": {
        "model": "openai/gpt-6-sol",
        "skills": [
          "*"
        ],
        "mcps": []
      },
      "oracle": {
        "model": "9router/cc/claude-opus-5-5",
        "variant": "high",
        "skills": [
          "simplify"
        ],
        "mcps": []
      },
      "librarian": {
        "model": "openai/gpt-6-luna",
        "variant": "low",
        "skills": [],
        "mcps": [
          "context7",
          "gh_grep"
        ]
      },
      "explorer": {
        "model": "openai/gpt-6-luna",
        "variant": "low",
        "skills": [],
        "mcps": []
      },
      "designer": {
        "model": "openai/gpt-6-luna",
        "variant": "medium",
        "skills": [],
        "mcps": []
      },
      "fixer": {
        "model": "9router/cc/claude-sonnet-5",
        "variant": "low",
        "skills": [],
        "mcps": []
      }
    }
  },
  "companion": {
    "enabled": false, // installed path ~/.local/share/opencode/storage/oh-my-opencode-slim
    "position": "bottom-right",
    "size": "medium",
    "gifPack": "default",
    "loopStyle": "classic",
    "speed": 1,
    "debug": false
  },
  "multiplexer": {
    "type": "none", // set to tmux and start "opencode --port PORT" to expose server, that subagent session can be attached to the server
    "layout": "main-vertical",
    "main_pane_size": 60
  }
}
