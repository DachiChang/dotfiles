{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "custom-gruvbox",
    "mode": "dark"
  },
  "keybinds": {
    "command.palette.show": "ctrl+\\",
    "leader": "ctrl+o",
    "session.tab.next": "ctrl+n",
    "session.tab.previous": "ctrl+p",
    "session.tab.close": "ctrl+q",
    "session.list": "ctrl+l",
    "agent.cycle": "tab",
    "model.cycle_favorite": "ctrl+]",
    "dialog.move_session.move": "ctrl+g",
    "terminal.toggle": false,
    "open.menu": false
  },
  "tabs": {
    "mode": "on"
  },
  "session": {
    "sidebar": "hide",
    "thinking": "show"
  }
}
