{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    }
  ],
  "providers": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        },
        "gpt-6-luna": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        },
        "gpt-6-astra": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        }
      }
    },
    "9router": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:NINEROUTER_URL}/v1",
        "apiKey": "{env:NINEROUTER_KEY}"
      },
      "models": {
        "cc/claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          },
        },
        "cc/claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          },
        }
      }
    }
  },
  "agents": {
    "plan": {
      "color": "#83a598",
      "model": "9router/cc/claude-opus-5-5",
    },
    "build": {
      "color": "#fb4934",
      "model": "9router/cc/claude-opus-5-5",
    },
    "explore": {
      "color": "#b8bb26",
      "model": "openai/gpt-6-luna#low",
    },
    "general": {
      "color": "#d3869b",
      "model": "9router/cc/claude-sonnet-5#medium",
    },
    "title": {
      "model": "openai/gpt-5.6-luna#low"
    },
  },
  "snapshots": false,
  "skills": [
    "~/skills"
  ],
  "worktree": {
    "directory": ".worktree",
  },
  "websearch": {
    "provider": "exa",
  },
  "mcp": {
    "servers": {
      "tw-591": {
        "type": "local",
        "command": [
          "mcp-591"
        ],
        "disabled": true
      },
      "finacompass": {
        "type": "local",
        "command": [
          "finacompass",
          "mcp"
        ],
        "disabled": false,
        "environment": {
          "FINACOMPASS_SERVER_URL": "http://localhost:8080",
          "FINACOMPASS_TIMEOUT": "30s"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "disabled": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": false
      }
    }
  },
  // "references": {
  //   "goath-ddd-design": {
  //     "path": "~/workspace/aicova/fina-compass",
  //     "description": "Use when designing or implementing full-stack applications with Go, Alpine.js, Tailwind CSS, templ, and HTMX. Refer to this project for DDD architecture, module boundaries, and implementation patterns."
  //   }
  // }
}
