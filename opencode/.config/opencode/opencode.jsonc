{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "openai/gpt-6.2-sol",
  "permissions": [ // use 9router as media provider
    {
      "action": "generate_image",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "generate_video",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "/private{env:TMPDIR}*",
      "effect": "allow"
    },
  ],
  "providers": {
    "anthropic": {
      "settings": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "{env:NINEROUTER_KEY}",
      },
      "models": {
        "claude-opus-5-5": {
          "body": {
            "thinking": {
              "display": "omitted"
            }
          }
        },
        "claude-sonnet-5-5": {
          "body": {
            "thinking": {
              "display": "omitted"
            }
          }
        }
      },
    },
    "9router": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:NINEROUTER_URL}/v1",
        "apiKey": "{env:NINEROUTER_KEY}"
      },
    }
  },
  "agents": {
    "plan": {
      "color": "#83a598",
    },
    "build": {
      "color": "#fb4934",
    },
    "explore": {
      "color": "#b8bb26",
      "model": "openai/gpt-6.1-terra#low",
    },
    "general": {
      "color": "#d3869b",
      "model": "anthropic/claude-sonnet-5-5#medium",
      // opencode use 9router api-key to connect local 9router
      // 9router will search model in combo list first then in provider
      // combo list exist same model name will be used once exist
    },
    "title": {
      "model": "openai/gpt-6-luna#none"
    },
  },
  "snapshots": false,
  "skills": [
    "~/skills"
  ],
  "worktree": {
    "directory": "../",
  },
  "websearch": {
    "provider": "exa",
  },
  "mcp": {
    "servers": {
      "tw-591": {
        "type": "local",
        "cwd": "~", // local mcp use same pool need to set the same "cwd"
        "pool": true,
        "command": [
          "mcp-591"
        ],
        "disabled": true
      },
      "finacompass": {
        "type": "local",
        "cwd": "~",
        "pool": true,
        "command": [
          "finacompass",
          "mcp"
        ],
        "disabled": false,
        "environment": {
          "FINACOMPASS_SERVER_URL": "http://localhost:8080",
          "FINACOMPASS_TIMEOUT": "30s"
        }
      },
      "context7": {
        "type": "remote",
        "pool": true,
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "disabled": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "protocol": "legacy",
        "disabled": false
      },
      "hackmd": {
        "type": "remote",
        "pool": true,
        "url": "https://mcp.hackmd.io",
        "disabled": false
      }
    }
  },
  "plugins": [
    "@mohak34/opencode-notifier@1.1.3"
  ]
  // "references": {
  //   "goath-ddd-design": {
  //     "path": "~/workspace/aicova/fina-compass",
  //     "description": "Use when designing or implementing full-stack applications with Go, Alpine.js, Tailwind CSS, templ, and HTMX. Refer to this project for DDD architecture, module boundaries, and implementation patterns."
  //   }
  // }
}
