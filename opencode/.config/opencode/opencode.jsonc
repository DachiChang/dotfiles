{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "openai/gpt-6.2-sol",
  // 階段一：每一步送給模型前，決定工具清單
  // 1. 列出所有註冊的工具（內建 + plugin + MCP）
  // 2. 對每個工具：
  //    a. 呼叫端設成隱藏（hidden）→ 跳過
  //    b. 取得權限名稱 = tool.options.permission ?? 工具名稱
  //    c. 從 {ask} 開始，依序掃過合併後的整份規則：
  //       - 規則的 action 對不上 → 跳過
  //       - resource 是 *（全部比對）→ 集合清空，只放這條的 effect
  //       - resource 是窄的 → 把 effect 加進集合
  //    d. 集合只有 {deny} → 隱藏
  //       其他情況（有 ask 或 allow）→ 保留
  // 3. 保留下來的工具分兩類：
  //    - 預設放進 Code Mode 的 → 放進 execute 的目錄
  //    - 其他 → 直接列出
  //    （execute 本身被全部 deny 的話，Code Mode 會關掉，裡面的工具改成直接列出）
  // 4. 把清單送給模型

  // 這個階段還不知道具體資源，所以只能判斷「這個工具有沒有可能被允許」。
  //
  // 階段二：模型呼叫工具時，判斷這一次能不能執行
  // 1. 工具決定這次要檢查哪些 (action, resource)
  //    例如 read /Users/x/foo.txt：
  //      - 路徑在專案外 → 先檢查 (external_directory, /Users/x/*)
  //      - 再檢查 (read, /Users/x/foo.txt)
  // 2. 每一組：從規則清單的「最後一條」往前找，第一條符合的就是結果
  //    （找不到任何符合的規則 → ask）
  // 3. 有多個資源時合併結果，例如一次 patch 改好幾個檔案：
  //      任何一個 deny → deny
  //      否則任何一個 ask → ask
  //      否則 → allow
  // 4. 結果是 ask → 再查已記住的核准，有的話改成 allow
  // 5. policies 有 deny → 改成 deny
  // 6. 依最後的結果處理：
  //      allow → 直接執行
  //      ask   → 詢問你（允許一次 / 永遠允許 / 拒絕）
  //      deny  → 擋下，回錯誤給模型
  //
  // 可以使用 opencode debug agents 來列出每個 agents 最終算完的工具和 code mode 列表
  "permissions": [ // use 9router as media provider
    {
      "action": "generate_image",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "generate_video",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "/private{env:TMPDIR}*",
      "effect": "allow"
    },
  ],
  "providers": {
    "anthropic": {
      "settings": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "{env:NINEROUTER_KEY}",
      },
      "models": {
        "claude-opus-5-5": {
          "body": {
            "thinking": {
              "display": "omitted"
            }
          }
        },
        "claude-sonnet-5-5": {
          "body": {
            "thinking": {
              "display": "omitted"
            }
          }
        }
      },
    },
    "9router": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:NINEROUTER_URL}/v1",
        "apiKey": "{env:NINEROUTER_KEY}"
      },
    }
  },
  "agents": {
    "plan": {
      "color": "#83a598",
    },
    "build": {
      "color": "#fb4934",
    },
    "explore": {
      "color": "#b8bb26",
      "model": "openai/gpt-6.1-terra#low",
    },
    "general": {
      "color": "#d3869b",
      "model": "anthropic/claude-sonnet-5-5#medium",
      // opencode use 9router api-key to connect local 9router
      // 9router will search model in combo list first then in provider
      // combo list exist same model name will be used once exist
    },
    "title": {
      "model": "openai/gpt-6-luna#none"
    },
  },
  "snapshots": false,
  "skills": [
    "~/skills"
  ],
  "worktree": {
    "directory": "../",
  },
  "websearch": {
    "provider": "exa",
  },
  "mcp": {
    "servers": {
      "tw-591": {
        "type": "local",
        "cwd": "~", // local mcp use same pool need to set the same "cwd"
        "pool": true,
        "command": [
          "mcp-591"
        ],
        "disabled": true
      },
      "finacompass": {
        "type": "local",
        "cwd": "~",
        "pool": true,
        "command": [
          "finacompass",
          "mcp"
        ],
        "disabled": false,
        "environment": {
          "FINACOMPASS_SERVER_URL": "http://localhost:8080",
          "FINACOMPASS_TIMEOUT": "30s"
        }
      },
      "context7": {
        "type": "remote",
        "pool": true,
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "disabled": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "protocol": "legacy",
        "disabled": false
      },
      "hackmd": {
        "type": "remote",
        "pool": true,
        "url": "https://mcp.hackmd.io",
        "disabled": false
      }
    }
  },
  "plugins": [
    "@mohak34/opencode-notifier@1.1.3"
  ]
  // "references": {
  //   "goath-ddd-design": {
  //     "path": "~/workspace/aicova/fina-compass",
  //     "description": "Use when designing or implementing full-stack applications with Go, Alpine.js, Tailwind CSS, templ, and HTMX. Refer to this project for DDD architecture, module boundaries, and implementation patterns."
  //   }
  // }
}
