{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "openai/gpt-6.2-sol",
  "permissions": [ // use 9router as media provider
    {
      "action": "experimental_image_generate",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "providers": {
    "9router": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:NINEROUTER_URL}/v1",
        "apiKey": "{env:NINEROUTER_KEY}"
      },
      "models": {
        "combo-claude-sonnet-5-5": {
          "name": "Claude Sonnet 5.5",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "effort": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          },
        },
        "combo-claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "effort": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          },
        }
      }
    }
  },
  "agents": {
    "plan": {
      "color": "#83a598",
    },
    "build": {
      "color": "#fb4934",
    },
    "explore": {
      "color": "#b8bb26",
      "model": "openai/gpt-6.1-terra#low",
    },
    "general": {
      "color": "#d3869b",
      "model": "9router/combo-claude-sonnet-5-5medium",
    },
    "title": {
      "model": "openai/gpt-6-luna#none"
    },
  },
  "snapshots": false,
  "skills": [
    "~/skills"
  ],
  "worktree": {
    "directory": "../",
  },
  "websearch": {
    "provider": "exa",
  },
  "mcp": {
    "servers": {
      "tw-591": {
        "type": "local",
        "cwd": "~", // local mcp 使用 pool 必須指定相同的 cwd
        "pool": true,
        "command": [
          "mcp-591"
        ],
        "disabled": true
      },
      "finacompass": {
        "type": "local",
        "cwd": "~",
        "pool": true,
        "command": [
          "finacompass",
          "mcp"
        ],
        "disabled": false,
        "environment": {
          "FINACOMPASS_SERVER_URL": "http://localhost:8080",
          "FINACOMPASS_TIMEOUT": "30s"
        }
      },
      "context7": {
        "type": "remote",
        "pool": true,
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "disabled": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "gh_grep": {
        "type": "remote",
        "pool": true,
        "url": "https://mcp.grep.app",
        "disabled": false
      },
      "hackmd": {
        "type": "remote",
        "pool": true,
        "url": "https://mcp.hackmd.io",
        "disabled": false
      }
    }
  },
  // "references": {
  //   "goath-ddd-design": {
  //     "path": "~/workspace/aicova/fina-compass",
  //     "description": "Use when designing or implementing full-stack applications with Go, Alpine.js, Tailwind CSS, templ, and HTMX. Refer to this project for DDD architecture, module boundaries, and implementation patterns."
  //   }
  // }
}
