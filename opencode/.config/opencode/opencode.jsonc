{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "enabled_providers": [
    "9router",
    "openai",
  ],
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    }
  },
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:NINEROUTER_URL}/v1",
        "apiKey": "{env:NINEROUTER_KEY}"
      },
      "models": {
        "cc/claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "cc/claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
      }
    }
  },
  "agent": {
    "orchestrator": {
      "color": "success"
    },
    "explorer": {
      "disable": false,
    },
    "plan": {
      "color": "secondary",
      "model": "9router/cc/claude-opus-5-5",
      "permission": {
        "task": "deny"
      }
    },
    "build": {
      "color": "error",
      "model": "9router/cc/claude-opus-5-5",
      "permission": {
        "task": "deny"
      }
    },
    "title": {
      "model": "openai/gpt-5.6-luna"
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": false,
  "snapshot": false,
  "skills": {
    "paths": [
      "~/skills"
    ]
  },
  "mcp": {
    "openpets": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@open-pets/cli@2.0.7",
        "mcp",
        "--pet",
        "cinnamonroll"
      ],
      "enabled": true
    },
    "tw-591": {
      "type": "local",
      "command": [
        "mcp-591"
      ],
      "enabled": false
    },
    "tw-company": {
      "type": "local",
      "command": [
        "uv",
        "tool",
        "run",
        "mcp-tw-company"
      ],
      "enabled": false
    },
    "finacompass": {
      "type": "local",
      "command": [
        "finacompass",
        "mcp"
      ],
      "enabled": true,
      "environment": {
        "FINACOMPASS_SERVER_URL": "http://localhost:8080",
        "FINACOMPASS_TIMEOUT": "30s"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  },
  "instructions": [
    "openpets.md"
  ],
  "plugin": [
    [
      "@open-pets/opencode@2.0.7",
      {
        "pet": "cinnamonroll"
      }
    ],
    "oh-my-opencode-slim"
  ]
}
